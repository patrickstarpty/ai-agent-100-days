# 本课程自己约定的变量，复制成 .env 后按需填写；.env 不要提交进仓库。

# Day02：模型名，写法通常是“供应商/模型名”，具体以 litellm 文档为准。
LLM_MODEL=

# Day02：可选，走 OpenAI 兼容端点或本地模型时，用来指定服务地址。
LLM_API_BASE=

# 供应商密钥（如 OPENAI_API_KEY、AZURE_API_KEY 等）的变量名按 litellm 文档（Day02 阅读材料）来定，不在这里列出。

# Day68：OpenTelemetry 导出目标，例如本地 Collector 或追踪后端的 OTLP traces 端点。
OTLP_TRACES_ENDPOINT=

# Day69：接入 Langfuse 时用到的变量，不接入可以留空。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
